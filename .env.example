# Server-only integrations. Set these in Vercel Project Settings for
# Production, Preview, and Development as appropriate. Never expose them as
# NEXT_PUBLIC_* variables.
PASSPORT_API_URL=https://<your-render-service>.onrender.com
PASSPORT_API_KEY=<must-match-PHOTO_API_KEY-on-render>

# Existing application integrations
NEXT_PUBLIC_BASE_URL=https://www.pixpassvisa.com
NEXTAUTH_URL=https://www.pixpassvisa.com
NEXTAUTH_SECRET=<random-secret>
MONGODB_URI=<mongodb-connection-string>

# Optional: published YouTube video ID for the photo guide player
NEXT_PUBLIC_PHOTO_VIDEO_YOUTUBE_ID=

# Contact-form protection: production form stays disabled until both Turnstile keys exist.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_RATE_LIMIT_SECRET=
# Canonical origin used for contact requests and challenge hostname validation.
NEXT_PUBLIC_APP_URL=https://www.pixpassvisa.com
# Local interactive review only; never enable in deployment.
CHECKOUT_REVIEW_DEMO=0
